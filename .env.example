# Local development environment template.
# Copy to .env and fill in values. Never commit .env.
# Production secrets are always Key Vault-backed (*_secret_ref) — see doc 17 and
# CLAUDE.md "Secrets". This file is for local/dev convenience only.

ENVIRONMENT=dev

# FastAPI / runtime
API_HOST=0.0.0.0
API_PORT=8000

# Hugging Face Inference API (initial SLM/embedding provider — doc 15, doc 14)
HUGGINGFACE_API_TOKEN=

# Langfuse (observability — doc 24)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Azure (populated as later phases wire real integrations — doc 25)
AZURE_KEY_VAULT_URL=
AZURE_SERVICE_BUS_CONNECTION_STRING=
