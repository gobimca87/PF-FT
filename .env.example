# Local development environment template.
# Copy to .env and fill in values. Never commit .env.
# Production secrets are always Key Vault-backed (*_secret_ref) — see doc 17 and
# CLAUDE.md "Secrets". This file is for local/dev convenience only.

ENVIRONMENT=dev

# FastAPI / runtime
API_HOST=0.0.0.0
API_PORT=8000

# Azure AI Foundry — hosted-first SLM + embedding inference plane (ADR-D3-29, supersedes
# ADR-D3-13). In-tenancy Azure; authenticated via the enterprise SPN / managed identity
# (the AZURE_* values below). In deployed environments the endpoint is Key Vault-backed via
# *_secret_ref (ADR-D5-07); these vars are for local/dev convenience only.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview

# Hugging Face Inference API — NOT USED (ADR-D3-29). The design has no active external SLM
# path: production and evaluation both run in-tenancy on Azure AI Foundry. The HF adapter is
# kept dormant behind the ADR-D3-14 abstraction only for possible future reintroduction; set
# this token solely if that dormant adapter is ever deliberately activated.
HUGGINGFACE_API_TOKEN=

# Langfuse (observability — doc 24)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Azure Key Vault + service principal (ADR-D5-07 / ADR-D5-20). The Key Vault connection is
# established ONLY from the enterprise SPN (tenant id + client id + client secret) — no other
# authentication method is used. In deployed environments (uat/staging/prod) these four
# values are held by the Azure DevOps CI/CD pipeline variable group and injected into the
# workload's environment; every `*_secret_ref` in config is then resolved from Key Vault.
# Leave them blank for pure-local dev (dev/test fall back to the process environment).
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Service Bus connection string (doc 11 §27, §123-124 — Phase 12). In deployed environments
# this is resolved from Key Vault via connection.connection_string_secret_ref in
# config/base/service-bus.yaml (SPN-backed); this local var is only for dev/test convenience.
AZURE_SERVICE_BUS_CONNECTION_STRING=
