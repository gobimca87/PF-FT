# Local development environment template.
# Copy to .env and fill in values. Never commit .env.
# Production secrets are always Key Vault-backed (*_secret_ref) — see doc 17 and
# CLAUDE.md "Secrets". This file is for local/dev convenience only.

ENVIRONMENT=dev

# FastAPI / runtime
API_HOST=0.0.0.0
API_PORT=8000

# Hugging Face Inference API (initial SLM/embedding provider — doc 15, doc 14)
HUGGINGFACE_API_TOKEN=

# Langfuse (observability — doc 24)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Azure Key Vault + service principal (ADR-D5-07 / ADR-D5-20). The Key Vault connection is
# established ONLY from the enterprise SPN (tenant id + client id + client secret) — no other
# authentication method is used. In deployed environments (uat/staging/prod) these four
# values are held by the Azure DevOps CI/CD pipeline variable group and injected into the
# workload's environment; every `*_secret_ref` in config is then resolved from Key Vault.
# Leave them blank for pure-local dev (dev/test fall back to the process environment).
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Service Bus connection string (doc 11 §27, §123-124 — Phase 12). In deployed environments
# this is resolved from Key Vault via connection.connection_string_secret_ref in
# config/base/service-bus.yaml (SPN-backed); this local var is only for dev/test convenience.
AZURE_SERVICE_BUS_CONNECTION_STRING=
